<?xml version="1.0" encoding="UTF-8"?>
<!--
    pom.xml - Maven Project Object Model for TourismFX
    ===================================================
    This file defines the project's dependencies, build plugins, and configuration.
    It uses Spring Boot as the parent POM for simplified dependency management.
    
    Target Environment:
      - Server: Apache Tomcat/8.5.96 (embedded via Spring Boot)
      - OS: Windows 10 (amd64)
      - JVM: Oracle JDK 23.0.2
      - IDE: Visual Studio Code
      - Database: MySQL 8.x
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot parent POM: provides dependency version management,
         default plugin configurations, and production-ready defaults -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <!-- Project coordinates: uniquely identify this project in Maven repositories -->
    <groupId>com.example</groupId>
    <artifactId>tourismfx</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>TourismFX - Tourism Docket Management System</name>
    <description>
        A professional Java web application for managing tourism operations,
        featuring hotel bookings, payment integration (PayPal and M-Pesa),
        PDF receipt generation, and email notifications.
    </description>

    <properties>
        <!-- Java 17 for broad compatibility; runs perfectly on JVM 23 -->
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>

        <!-- ======================== SPRING BOOT STARTERS ======================== -->

        <!-- Web Starter: embedded Tomcat server, Spring MVC, REST support,
             JSON serialization with Jackson -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Thymeleaf Starter: server-side HTML template engine that produces
             natural, readable templates for our responsive web UI -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- JPA Starter: Hibernate ORM for database operations,
             Spring Data JPA for repository abstractions -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Validation Starter: Bean validation with Hibernate Validator
             for input sanitization and form validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Mail Starter: JavaMail integration for sending booking
             confirmation emails and receipt attachments -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Security Starter: authentication, authorization, CSRF protection,
             session management for tourist and admin accounts -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Thymeleaf Security Dialect: enables sec:authorize attributes
             in templates for role-based content rendering -->
        <dependency>
            <groupId>org.thymeleaf.extras</groupId>
            <artifactId>thymeleaf-extras-springsecurity5</artifactId>
        </dependency>

        <!-- DevTools: automatic restart on code changes, LiveReload support,
             and developer-friendly property defaults for VS Code workflow -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- ======================== DATABASE DRIVERS ======================== -->

        <!-- MySQL Connector/J: JDBC driver for MySQL 8.x database connectivity -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- H2 Database: lightweight in-memory database for rapid testing
             and development when MySQL is not available -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ======================== PDF GENERATION ======================== -->

        <!-- iText 7 Core: professional PDF generation library for creating
             printable booking receipts with tables, logos, and formatting -->
        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>itext7-core</artifactId>
            <version>7.2.5</version>
            <type>pom</type>
        </dependency>

        <!-- iText HTML2PDF: converts HTML receipt templates to PDF documents,
             allowing reuse of Thymeleaf templates for PDF generation -->
        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>html2pdf</artifactId>
            <version>4.0.5</version>
        </dependency>

        <!-- ======================== PAYMENT INTEGRATION ======================== -->

        <!-- PayPal Checkout SDK: official PayPal SDK for processing payments
             through PayPal's REST API (orders, captures, refunds) -->
        <dependency>
            <groupId>com.paypal.sdk</groupId>
            <artifactId>checkout-sdk</artifactId>
            <version>1.0.5</version>
        </dependency>

        <!-- OkHttp: modern HTTP client used for M-Pesa Daraja API integration
             (STK Push, transaction status queries, OAuth token management) -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>4.12.0</version>
        </dependency>

        <!-- Gson: JSON serialization/deserialization for parsing payment
             gateway API responses (M-Pesa, PayPal webhooks) -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>

        <!-- ======================== UTILITIES ======================== -->

        <!-- Lombok: annotation processor that eliminates boilerplate code
             (auto-generates getters, setters, constructors, builders) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ======================== TESTING ======================== -->

        <!-- Spring Boot Test: comprehensive testing support with JUnit 5,
             Mockito, Spring Test Context, and assertion libraries -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Security Test: utilities for testing secured endpoints,
             mock users, and authentication scenarios -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot Maven Plugin: packages the application as an executable
                 JAR with embedded Tomcat server for standalone deployment -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- Exclude Lombok from final JAR (it's compile-time only) -->
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
